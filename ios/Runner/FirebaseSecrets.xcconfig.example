# Copy this file to FirebaseSecrets.xcconfig and fill in your values.
# Get these values from ios/Runner/GoogleService-Info.plist after running `flutterfire configure`.
#
# GID_CLIENT_ID = the CLIENT_ID value from GoogleService-Info.plist
# REVERSED_CLIENT_ID = the REVERSED_CLIENT_ID value from GoogleService-Info.plist

GID_CLIENT_ID = YOUR_CLIENT_ID.apps.googleusercontent.com
REVERSED_CLIENT_ID = com.googleusercontent.apps.YOUR_CLIENT_ID
